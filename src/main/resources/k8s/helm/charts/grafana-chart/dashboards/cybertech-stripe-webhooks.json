{
  "uid": "cybertech-stripe-webhooks",
  "title": "Cybertech — Stripe Webhooks",
  "tags": ["cybertech", "stripe", "webhooks"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Webhook 4xx / 5xx rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{app=\"cybertech-app\",uri=~\"/api/v1/webhooks/stripe.*\",status=~\"4..|5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dedup ledger size",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "cybertech_stripe_dedup_ledger_size"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Signature failures (1m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cybertech_stripe_webhook_signature_failures_total[1m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Webhook events processed by type",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{event_type}}",
          "expr": "sum by (event_type) (rate(cybertech_stripe_webhook_events_total[5m]))"
        }
      ]
    }
  ]
}
