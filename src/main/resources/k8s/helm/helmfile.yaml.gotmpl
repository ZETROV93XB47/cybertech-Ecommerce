environments:
  default:
    values:
      - environments/default.yaml
  production:
    values:
      - environments/production.yaml

---

helmDefaults:
  wait: true
  timeout: 300
  recreatePods: false
  force: false

releases:

  # ============================================================
  # LAYER 1 — Databases & infrastructure (no dependencies)
  # ============================================================

  - name: mysql
    chart: ./charts/mysql-chart
    namespace: default
    values:
      - ./charts/mysql-chart/values.yaml
    set:
      - name: mysql.rootPassword
        value: {{ requiredEnv "MYSQL_ROOT_PASSWORD" | quote }}

  - name: mongodb
    chart: ./charts/mongodb-chart
    namespace: default
    values:
      - ./charts/mongodb-chart/values.yaml

  - name: redis
    chart: ./charts/redis-chart
    namespace: default
    values:
      - ./charts/redis-chart/values.yaml

  - name: elasticsearch
    chart: ./charts/elasticsearch-chart
    namespace: default
    values:
      - ./charts/elasticsearch-chart/values.yaml

  # ============================================================
  # LAYER 2 — Services that depend on Layer 1
  # ============================================================

  - name: keycloak
    chart: ./charts/keycloak-chart
    namespace: default
    needs:
      - mysql
    values:
      - ./charts/keycloak-chart/values.yaml

  - name: rustfs
    chart: ./charts/rustfs-chart
    namespace: default
    values:
      - ./charts/rustfs-chart/values.yaml
    set:
      - name: credentials.accessKey
        value: {{ requiredEnv "RUSTFS_ACCESS_KEY" | quote }}
      - name: credentials.secretKey
        value: {{ requiredEnv "RUSTFS_SECRET_KEY" | quote }}

  - name: gorse
    chart: ./charts/gorse-chart
    namespace: default
    needs:
      - mysql
      - redis
    values:
      - ./charts/gorse-chart/values.yaml

  - name: mailpit
    chart: ./charts/mailpit-chart
    namespace: default
    values:
      - ./charts/mailpit-chart/values.yaml

  - name: moderation-api
    chart: ./charts/moderation-api-chart
    namespace: default
    values:
      - ./charts/moderation-api-chart/values.yaml

  - name: stripe
    chart: ./charts/stripe-chart
    namespace: default
    values:
      - ./charts/stripe-chart/values.yaml
    set:
      - name: stripe.apiKey
        value: {{ requiredEnv "STRIPE_API_KEY" | quote }}

  # ============================================================
  # LAYER 3 — Main application (depends on everything)
  # ============================================================

  - name: cybertech-app
    chart: ./charts/cybertech-app-chart
    namespace: default
    needs:
      - mysql
      - mongodb
      - redis
      - elasticsearch
      - keycloak
      - rustfs
      - gorse
      - mailpit
      - moderation-api
      - stripe
    values:
      - ./charts/cybertech-app-chart/values.yaml
    set:
      - name: mysql.password
        value: {{ requiredEnv "MYSQL_ROOT_PASSWORD" | quote }}
      - name: keycloak.clientSecret
        value: {{ requiredEnv "KEYCLOAK_CLIENT_SECRET" | quote }}
      - name: aws.s3.secretAccessKey
        value: {{ requiredEnv "RUSTFS_SECRET_KEY" | quote }}
      - name: aws.s3.accessKeyId
        value: {{ requiredEnv "RUSTFS_ACCESS_KEY" | quote }}
      - name: appSecrets.cardEncryptionKey
        value: {{ requiredEnv "APP_CARD_ENCRYPTION_KEY" | quote }}
      - name: hostAliases[0].ip
        value: {{ requiredEnv "MINIKUBE_IP" | quote }}
      - name: hostAliases[0].hostnames[0]
        value: "s3.cybertech.local"
      - name: hostAliases[0].hostnames[1]
        value: "keycloak.cybertech.local"
      - name: stripe.apiKey
        value: {{ requiredEnv "STRIPE_API_KEY" | quote }}
      - name: stripe.webhookSecret
        value: {{ requiredEnv "STRIPE_WEBHOOK_SECRET" | quote }}
