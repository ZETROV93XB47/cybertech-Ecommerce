                        <artifactId>spring-restdocs-asciidoctor</artifactId>
                        <version>${spring-restdocs.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <to>
                        <image>cybertech</image>
                    </to>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!-- W0: bumped from 0.8.13 to 0.8.14 because 0.8.13 cannot read Java 26 (class file v70) bytecode. -->
                <version>0.8.14</version>
                <configuration>
                    <excludes>
                        <exclude>**/CyberTechApplication.class</exclude>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/api/error/model/**</exclude>
                        <exclude>**/entities/enums/**</exclude>
                        <exclude>**/entities/valueObjects/**</exclude>
                        <exclude>**/entities/document/**</exclude>
                        <exclude>**/entities/attributes/**</exclude>
                        <exclude>**/entities/*Entity.class</exclude>
                        <exclude>**/mappers/**/*MapperImpl.class</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/logger/**</exclude>
                        <exclude>**/constants/**</exclude>
                        <exclude>**/annotation/**</exclude>
                        <exclude>**/api/controllers/spec/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- W0: gate created off; W6 flipped haltOnFailure=true (2026-04-23) — bundle line 92.48%, branch 91.19%. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{jacocoArgLine} --enable-preview</argLine>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                        <exclude>**/CybertechApplicationTests.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!--
                PRE-5: spring-boot-starter-parent binds failsafe to `integration-test`/`verify`
                in its own <build><plugins>, so a bare `mvn verify` would still try to run
                ITs. We force-skip them here by default; the `integration-test` profile
                (declared at the bottom of this POM) flips skipITs back to false and
                attaches the project's IT include patterns + jacoco argLine.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <skipITs>true</skipITs>
                </configuration>
            </plugin>
            <!--
                springdoc-openapi-maven-plugin — opt-in static OpenAPI contract export.

                With <skip>true</skip> the plugin does NOT auto-run on `mvn verify`. To regenerate
                the canonical docs/openapi/openapi.yaml from a running app:

                  1. Boot the app:  ./mvnw spring-boot:run -Dspring-boot.run.profiles=test
                  2. In another shell: ./mvnw -Dskip=false springdoc-openapi:generate

                The committed docs/openapi/openapi.yaml is the contract Postman / front-end /
                third parties consume between regenerations.
            -->
            <plugin>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-maven-plugin</artifactId>
                <version>1.4</version>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals><goal>generate</goal></goals>
                        <phase>integration-test</phase>
                    </execution>
                </executions>
                <configuration>
                    <apiDocsUrl>http://localhost:8081/v3/api-docs.yaml</apiDocsUrl>
                    <outputFileName>openapi.yaml</outputFileName>
                    <outputDir>${project.basedir}/docs/openapi</outputDir>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        PRE-5: Failsafe is now bound to the `integration-test` profile only.

        Default `mvn verify` runs unit tests + JaCoCo gate but SKIPS integration tests.
        To execute the IT suite, opt-in explicitly:

            ./mvnw verify -Pintegration-test

        Rationale: previously `mvn verify -Pintegration-test` was a silent no-op (no
        such profile existed) and failsafe ran on every `verify`, slowing the default
        loop and surprising callers who expected the flag to gate ITs.
    -->
    <profiles>
        <profile>
            <id>integration-test</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <skipITs>false</skipITs>
                            <argLine>@{jacocoArgLine} --enable-preview</argLine>
                            <includes>
                                <include>**/*IT.java</include>
                                <include>**/*IntegrationTest.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <id>integration-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

