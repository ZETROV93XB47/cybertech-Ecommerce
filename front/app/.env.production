# Public env only. Secrets (AUTH_SECRET, AUTH_KEYCLOAK_SECRET, AUTH_KEYCLOAK_ID,
# AUTH_KEYCLOAK_ISSUER) come from the helm chart at runtime.
#
# Variable names match what `src/lib/api/client.ts` and `src/lib/auth.ts`
# actually read — Auth.js v5 uses the AUTH_* prefix natively, so NEXTAUTH_URL
# is not used.

# Backend base URL — read by src/lib/api/client.ts.
NEXT_PUBLIC_API_BASE=https://api.cybertech.local

# Auth.js v5 absolute origin for callback URL building.
AUTH_URL=https://cybertech.local
